# -*- coding: utf-8 -*-
"""数据迁移测试路由 — deposit 页 Creator 组「获取装载迁移数据」tab 的后端。

数据源 = **本机 chunkSvr 的调试 HTTP 口**（缺省 :60463 /v1.0/chunkluareq），打 Lua 侧
`migrationdryrun`：对指定 uid 跑「三档判定 + 采集 Lua 侧 5 项 + 组装推送载荷」，
把**会推给 CP 的那份载荷原文**返回给页面（只读干跑：不推送、不写去重缓存、不落任何状态）。

安全边界：
  - 全程只读；不触碰 CP / 125 / 任何数据库。
  - 依赖本机 chunkSvr 正在运行且调试口开启（ini `[HttpServerModule] port=60463`）；
    不可达时返回明确错误，不重试、不降级。
  - ⚠ chunkSvr 生产侧「不得以任何形式暴露 HTTP」是运营约束；本通路口只面向**本机调试口**，
    不构成生产暴露面。本页签仅用于本地/联调，上线勿依赖。
"""
import json
import os
import urllib.error
import urllib.request

from flask import jsonify, request

from . import app

# 独立总开关（与本模块之外的通路无关）
MIGRATION_ENABLED = True

# 本机 chunkSvr 调试口；可用环境变量覆盖以指向别的机器做联调
CHUNKSVR_DEBUG_URL = os.environ.get(
    'CHUNKSVR_DEBUG_URL', 'http://127.0.0.1:60463/v1.0/chunkluareq')
DRYRUN_TIMEOUT = 25
MAX_USERID = 2 ** 31 - 1


@app.route('/api/migration/dryrun', methods=['POST'])
def api_migration_dryrun():
    """输入 uid -> 返回 chunkSvr 采集并组装好的迁移推送载荷（只读干跑）。"""
    if not MIGRATION_ENABLED:
        return jsonify({'success': False, 'message': '迁移测试面已关闭'}), 503

    body = request.get_json(silent=True) or {}
    try:
        userid = int(body.get('userid'))
    except (TypeError, ValueError):
        return jsonify({'success': False, 'message': '玩家ID格式错误'}), 400
    if userid <= 0 or userid > MAX_USERID:
        return jsonify({'success': False, 'message': '玩家ID超出范围'}), 400

    appcode = (body.get('appcode') or 'xzmp').strip()
    gamevers = (body.get('gamevers') or '').strip()

    req_body = json.dumps({
        'req': 'migrationdryrun',
        'nUserID': userid,
        'code': appcode,
        'gamevers': gamevers,
    }).encode('utf-8')

    try:
        req = urllib.request.Request(
            CHUNKSVR_DEBUG_URL, data=req_body,
            headers={'Content-Type': 'application/json'}, method='POST')
        with urllib.request.urlopen(req, timeout=DRYRUN_TIMEOUT) as resp:
            outer = json.loads(resp.read().decode('utf-8', 'replace'))
    except urllib.error.HTTPError as e:
        return jsonify({'success': False,
                        'message': f'chunkSvr 调试口返回 HTTP {e.code}'}), 502
    except Exception as e:  # noqa: BLE001
        return jsonify({'success': False,
                        'message': f'连不上本机 chunkSvr 调试口（{CHUNKSVR_DEBUG_URL}）：{e}'}), 502

    if not isinstance(outer, dict):
        return jsonify({'success': False, 'message': 'chunkSvr 返回结构异常'}), 502
    if outer.get('err'):
        return jsonify({'success': False, 'message': f"chunkSvr: {outer['err']}"}), 502

    ret = outer.get('ret')
    if isinstance(ret, str):
        try:
            ret = json.loads(ret)
        except ValueError:
            return jsonify({'success': False,
                            'message': f'chunkSvr 返回非 JSON: {ret[:200]}'}), 502
    if not isinstance(ret, dict) or not ret.get('success'):
        err = (ret or {}).get('err') if isinstance(ret, dict) else ret
        return jsonify({'success': False, 'message': f'chunkSvr 干跑失败: {err}'}), 502

    payload_str = ret.get('payload') or ''
    payload_obj = None
    if payload_str:
        try:
            payload_obj = json.loads(payload_str)
        except ValueError:
            payload_obj = None

    return jsonify({'success': True, 'data': {
        'userid': userid,
        'appcode': appcode,
        'gamevers': gamevers,
        'len': ret.get('len'),
        'payload': payload_str,
        'payload_obj': payload_obj,
        'source': CHUNKSVR_DEBUG_URL,
    }}
    )
