        function enterTemplateEditMode(tabType) {
            templateEditMode = true;
            templateEditTab = tabType;
            const tab = document.getElementById(tabType);
            if (!tab) return;
            // 绿色: 所有输入框/文本域标记为 editing
            tab.querySelectorAll('input:not([type="radio"]):not([type="checkbox"]):not([readonly]), textarea').forEach(el => {
                el.classList.remove('template-modified');
                el.classList.add('template-editing');
