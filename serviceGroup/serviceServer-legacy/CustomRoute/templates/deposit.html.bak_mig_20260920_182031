        // 保存模板函数
        async function saveTemplate(tabType) {
            let templateData = {};

            // 编辑已有模板 → 直接覆盖，不问名；否则新建 → 问名
            const isUpdating = templateEditMode && currentEditingTemplate && templateEditTab === tabType;
            let templateName;
            if (isUpdating) {
                templateName = currentEditingTemplate.name;
            } else {
                templateName = prompt("请输入模板名称:");
                if (!templateName) {
                    return; // 用户取消输入
                }
            }

            if (tabType === 'gold') {
                const operation = document.querySelector('input[name="operationGold"]:checked').value;
                const goldCount = parseInt(document.getElementById('gold-count').value);
                templateData = {
                    operation: operation,
                    goldCount: goldCount
                };
                if (operation === 'single') {
                    templateData.userId = document.getElementById('user-id-gold').value.trim();
                } else {
                    templateData.userIds = document.getElementById('user-ids-gold').value.trim();
                }
            } else if (tabType === 'points') {
                templateData = {
                    userIds: document.getElementById('user-id-points').value.trim(),
                    count: parseInt(document.getElementById('points-count').value),
                    gameId: parseInt(document.getElementById('game-id-points').value),
                    opid: parseInt(document.querySelector('input[name="opidPoints"]:checked').value)
                };
            } else if (tabType === 'silver') {
                templateData = {
                    userIds: document.getElementById('user-id-silver').value.trim(),
                    count: parseInt(document.getElementById('silver-count').value),
                    gameId: parseInt(document.getElementById('game-id-silver').value),
                    opid: parseInt(document.querySelector('input[name="opidSilver"]:checked').value)
                };
            } else if (tabType === 'tqvip') {
                const rsChecked = document.querySelectorAll('#tqvip-rewardstatus input[type="checkbox"]:checked');
                templateData = {
                    userIds: document.getElementById('user-ids-tqvip').value.trim(),
                    experience: parseInt(document.getElementById('tqvip-experience').value),
                    lastLoginDate: document.getElementById('tqvip-last-login').value,
                    isdemoteani: parseInt(document.querySelector('input[name="tqvip-isdemoteani"]:checked').value),
                    rewardstatus: Array.from(rsChecked).map(cb => parseInt(cb.value))
                };
            } else if (tabType === 'weekcard') {
                templateData = {
                    userIds: document.getElementById('user-ids-weekcard').value.trim(),
                    days: parseInt(document.getElementById('weekcard-days').value)
                };
            } else if (tabType === 'monthcard') {
                templateData = {
                    userIds: document.getElementById('user-ids-monthcard').value.trim(),
                    days: parseInt(document.getElementById('monthcard-days').value)
                };
            } else if (tabType === 'costume') {
                templateData = {
                    userId: document.getElementById('user-id-costume').value.trim()
                };
            } else if (tabType === 'newplayergift') {
                const modeRadio = document.querySelector('input[name="newplayergift-mode"]:checked');
                templateData = {
                    userIds: document.getElementById('user-ids-newplayergift').value.trim(),
                    days: parseInt(document.getElementById('newplayergift-days').value) || 0,
                    mode: modeRadio ? modeRadio.value : 'received',
                    cancel: document.getElementById('newplayergift-cancel').checked
                };
            }

            try {
                const url = isUpdating ? '/api/templates/update' : '/api/templates/save';
                const payload = { name: templateName, type: tabType, data: templateData };
                if (isUpdating) payload.id = currentEditingTemplate.id;
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (result.success) {
                    alert(isUpdating ? '模板已更新！' : '模板保存成功！');
                    loadTemplates(); // 刷新模板列表
                    enterTemplateEditMode(tabType); // 模板已存 → 输入框回绿
