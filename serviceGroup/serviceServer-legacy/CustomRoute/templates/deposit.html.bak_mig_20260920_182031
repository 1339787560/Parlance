        // 查询: 玩家ID + 缩写 -> 该玩家相关模块 (redis / mysql 双源计数)
        async function cpLoadModules() {
            const userid = parseInt(document.getElementById('cp-userid').value);
            const appcode = document.getElementById('cp-appcode').value;
            const out = document.getElementById('cp-module-result');
            if (isNaN(userid) || userid <= 0) {
                out.innerHTML = '<div class="result error" style="display:block;">玩家ID格式错误</div>';
                return;
            }
            out.innerHTML = '<p>查询中...（redis db10 扫 key + mysql 逐表 count）</p>';
            try {
                const r = await cpPost('/api/cp-data/direct/modules', { userid: userid, appcode: appcode });
                if (!r.success) throw new Error(r.message);
                const d = r.data;
                const mods = d.modules || [];
                let html = '';
                if (mods.length === 0) {
                    html = `<p>玩家 ${d.userid} 在 ${cpEscape(d.appcode)} 下无模块数据（redis 与 mysql 均无）</p>`;
                } else {
                    html = `<h3 class="cp-section-title">相关模块 (${mods.length}) <small style="font-weight:normal; color:#888;">点击模块展开 redis / mysql 明细</small></h3>`;
                    for (const m of mods) {
                        const mismatch = m.redis_count !== m.mysql_rows;
                        html += `<div class="cp-mod-card" data-module="${encodeURIComponent(m.module)}"
                                     style="border:1px solid ${mismatch ? '#e0a800' : '#ddd'}; border-radius:6px; margin-bottom:6px;">
                            <div class="cp-mod-head" style="padding:8px 10px; cursor:pointer; display:flex; align-items:center; gap:10px;">
                                <span style="flex:1; font-weight:bold;">${cpEscape(m.module)}</span>
                                <span style="font-size:12px; padding:2px 6px; border-radius:3px; background:#eef4ff; color:#1a4f9c;">redis ${m.redis_count}</span>
                                <span style="font-size:12px; padding:2px 6px; border-radius:3px; background:#eefaf0; color:#1a7a3d;">mysql ${m.mysql_rows}</span>
                                ${mismatch ? '<span style="font-size:12px; color:#856404;" title="缓存与落盘不一致">⚠ 不一致</span>' : ''}
                                <span class="cp-mod-arrow" style="color:#888;">▸</span>
                            </div>
                            <div class="cp-mod-body" style="display:none; border-top:1px solid #eee; padding:10px;"></div>
                        </div>`;
                    }
                }
                if ((d.warnings || []).length) {
                    html += `<div class="result error" style="display:block; font-size:12px;">${d.warnings.map(cpEscape).join('<br>')}</div>`;
                }
                out.innerHTML = html;
                out.querySelectorAll('.cp-mod-head').forEach(head => {
                    head.addEventListener('click', () => cpToggleModule(head.closest('.cp-mod-card'), userid, appcode));
                });
                cpSaveState();
            } catch (e) {
                out.innerHTML = `<div class="result error" style="display:block;">查询失败: ${cpEscape(e.message)}</div>`;
                cpSaveState();
            }
        }

        // 展开/收起模块; 首次展开才拉明细
        async function cpToggleModule(card, userid, appcode) {
            const body = card.querySelector('.cp-mod-body');
            const arrow = card.querySelector('.cp-mod-arrow');
            if (body.style.display === 'block') {
                body.style.display = 'none';
                arrow.textContent = '▸';
                return;
            }
            body.style.display = 'block';
            arrow.textContent = '▾';
            if (body.dataset.loaded === '1') return;
            body.innerHTML = '<p>加载中...</p>';
            const module = decodeURIComponent(card.dataset.module);
            try {
                const r = await cpPost('/api/cp-data/direct/module',
                    { userid: userid, appcode: appcode, module: module });
                if (!r.success) throw new Error(r.message);
                body.innerHTML = cpRenderModuleDetail(r.data);
                body.dataset.loaded = '1';
                cpBindDetailClicks(body, userid, appcode, module);
            } catch (e) {
                body.innerHTML = `<div class="result error" style="display:block;">明细加载失败: ${cpEscape(e.message)}</div>`;
            }
        }

        function cpEscape(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // 单模块明细: 左 redis 右 mysql 并排 —— 两列对照一眼看出双轨差异
        function cpRenderModuleDetail(d) {
            const redisItems = d.redis || [];
            const my = d.mysql || {};
            const rows = my.rows || [];

            let left = `<h4 style="margin:0 0 6px 0; font-size:13px;">Redis db10（${redisItems.length} key）</h4>`;
            if (redisItems.length === 0) {
                left += '<small style="color:#888;">该模块无 redis key（可能已过期，或本就未写缓存）</small>';
            } else {
                for (const it of redisItems) {
                    left += `<div class="cp-detail-row" data-kind="redis" data-payload="${encodeURIComponent(JSON.stringify(it))}"
                                 style="cursor:pointer; padding:6px; margin-bottom:4px; border:1px solid #ddd; border-radius:4px; font-size:12px; word-break:break-all;">
                        <div><b>[${cpEscape(it.type)}]</b> ${cpEscape(it.key)}</div>
                        <div style="color:#555; max-height:64px; overflow:hidden;">${cpEscape(JSON.stringify(it.value)).slice(0, 200)}</div>
                    </div>`;
                }
            }

            let right = `<h4 style="margin:0 0 6px 0; font-size:13px;">MySQL ${cpEscape(my.table || '')}（${rows.length} 行）</h4>`;
            if (!my.exists) {
                right += '<small style="color:#888;">无对应落盘表，或该玩家无行</small>';
            } else if (rows.length === 0) {
                right += '<small style="color:#888;">表存在但该玩家无行</small>';
            } else {
                for (const row of rows) {
                    right += `<div class="cp-detail-row" data-kind="mysql" data-payload="${encodeURIComponent(JSON.stringify(row))}"
                                    style="cursor:pointer; padding:6px; margin-bottom:4px; border:1px solid #ddd; border-radius:4px; font-size:12px; word-break:break-all;">
                        <div><b>${cpEscape(row.name)}</b></div>
                        <div style="color:#555; max-height:64px; overflow:hidden;">${cpEscape(JSON.stringify(row.data)).slice(0, 200)}</div>
                        <div style="color:#999; font-size:11px;">create ${cpEscape(row.createtime)} · update ${cpEscape(row.updatetime)}</div>
                    </div>`;
                }
            }

            let warn = '';
            if ((d.warnings || []).length) {
                warn = `<div class="result error" style="display:block; font-size:12px; margin-bottom:6px;">${d.warnings.map(cpEscape).join('<br>')}</div>`;
            }
            return warn + '<div style="display:flex; gap:12px; align-items:flex-start; flex-wrap:wrap;">' +
                `<div style="flex:1; min-width:240px;">${left}</div>` +
                `<div style="flex:1; min-width:240px;">${right}</div></div>`;
        }

        // ---- 受控修改：点明细行 -> 写前实时查询 -> 在查询结果基础上改 -> 存在即写 ----
        let cpWriteCtx = null;       // {userid, appcode, module, redisKey, mysqlName}
        let cpWriteSnapshot = null;  // 上次写入返回的改前值，供「恢复改前值」

        // 点明细行 -> 先 write-prepare 实时查询（不改数据），拿到当前值当编辑起点
        function cpBindDetailClicks(scope, userid, appcode, module) {
            scope.querySelectorAll('.cp-detail-row').forEach(row => {
                row.addEventListener('click', () => {
                    const p = JSON.parse(decodeURIComponent(row.dataset.payload));
                    const isRedis = row.dataset.kind === 'redis';
                    cpOpenWrite({
                        userid, appcode, module,
                        redisKey: isRedis ? p.key : null,
                        mysqlName: isRedis ? null : p.name,
                    });
                });
            });
        }

        async function cpOpenWrite(ctx) {
            cpWriteCtx = ctx;
            cpWriteSnapshot = null;
            const ta = document.getElementById('cp-modal-value');
            const commitBtn = document.getElementById('cp-modal-commit');
            document.getElementById('cp-modal-title').textContent = `修改 · ${ctx.module}`;
            document.getElementById('cp-modal-info').textContent = '查询中...';
            document.getElementById('cp-modal-targets').innerHTML = '';
            document.getElementById('cp-modal-hint').textContent = '';
            document.getElementById('cp-modal-result').innerHTML = '';
            document.getElementById('cp-modal-revert').disabled = true;
            ta.value = '';
            ta.disabled = true;
            commitBtn.disabled = true;
            document.getElementById('cp-modal-mask').classList.add('open');
            try {
                const r = await cpPost('/api/cp-data/direct/write-prepare', {
                    userid: ctx.userid, appcode: ctx.appcode, module: ctx.module,
                    redisKey: ctx.redisKey || undefined,
                    mysqlName: ctx.mysqlName || undefined,
                });
                if (!r.success) throw new Error(r.message);
                const d = r.data;
                ta.value = typeof d.startValue === 'string'
                    ? d.startValue : JSON.stringify(d.startValue, null, 2);
                ta.disabled = false;
                commitBtn.disabled = false;

                const rt = d.redis || {}, mt = d.mysql || {};
                const chip = (on, label) => `<span style="display:inline-block;padding:2px 8px;border-radius:3px;margin-right:6px;background:${on ? '#eefaf0' : '#f4f4f4'};color:${on ? '#1a7a3d' : '#999'};">${label} ${on ? '✓ 将写入' : '✗ 无记录，跳过'}</span>`;
                document.getElementById('cp-modal-targets').innerHTML =
                    chip(d.targets.redis, 'redis') + chip(d.targets.mysql, 'mysql');

                const parts = [];
                if (rt.key) parts.push(`redis: ${rt.key}（${rt.type}）`);
                if (mt.table) parts.push(`mysql: ${mt.table} · name=${mt.name}`);
                document.getElementById('cp-modal-info').textContent = parts.join('  |  ');
                document.getElementById('cp-modal-hint').textContent =
                    `编辑起点取自 ${d.startFrom}（写前实时查询所得）`;
            } catch (e) {
                document.getElementById('cp-modal-info').textContent = '';
                document.getElementById('cp-modal-result').innerHTML =
                    `<div class="result error" style="display:block;">写前查询失败: ${cpEscape(e.message)}</div>`;
            }
        }

        async function cpCommitWrite() {
            const c = cpWriteCtx;
            if (!c) return;
            const ta = document.getElementById('cp-modal-value');
            let value;
            try {
                value = JSON.parse(ta.value);
            } catch (e) {
                document.getElementById('cp-modal-result').innerHTML =
                    `<div class="result error" style="display:block;">值不是合法 JSON: ${cpEscape(e.message)}</div>`;
                return;
            }
            if (!confirm(`⚠ 将修改玩家数据\n\n玩家ID: ${c.userid}\n模块: ${c.module}\n写入目标: 按「存在即写」自动判定\n\n确认写入?`)) return;
            const btn = document.getElementById('cp-modal-commit');
            btn.disabled = true;
            document.getElementById('cp-modal-result').innerHTML = '<div style="font-size:12px;">写入中...</div>';
            try {
                const r = await cpPost('/api/cp-data/direct/write', {
                    userid: c.userid, appcode: c.appcode, module: c.module, value,
                    redisKey: c.redisKey || undefined,
                    mysqlName: c.mysqlName || undefined,
                });
                if (!r.success) throw new Error(r.message);
                const w = r.data.written;
                cpWriteSnapshot = r.data.snapshot;
                document.getElementById('cp-modal-revert').disabled = false;
                document.getElementById('cp-modal-result').innerHTML =
                    `<div class="result" style="display:block;">写入成功：redis=${w.redis ? '是' : '否'}，mysql=${w.mysql ? '是' : '否'}` +
                    (w.mysql ? `（affected=${w.mysqlAffected}；0=值与原来相同）` : '') + '</div>';
                if ((r.data.warnings || []).length) {
                    document.getElementById('cp-modal-result').innerHTML +=
                        `<div class="result error" style="display:block; font-size:12px;">${r.data.warnings.map(cpEscape).join('<br>')}</div>`;
                }
                cpRefreshModule(c.userid, c.appcode, c.module);
            } catch (e) {
                document.getElementById('cp-modal-result').innerHTML =
                    `<div class="result error" style="display:block;">写入失败: ${cpEscape(e.message)}</div>`;
            } finally {
                btn.disabled = false;
            }
        }

        // 撤回：把上次写入的改前值原样回灌（走同一写端点，同样按存在即写）
        async function cpRevertWrite() {
            const s = cpWriteSnapshot, c = cpWriteCtx;
            if (!s || !c) return;
            const value = s.redis ? s.redis.before : (s.mysql || {}).before;
            if (value === undefined) {
                document.getElementById('cp-modal-result').innerHTML =
                    '<div class="result error" style="display:block;">快照里没有可回灌的改前值</div>';
                return;
            }
            if (!confirm(`⚠ 将把玩家 ${c.userid} 的 ${c.module} 写回改前值\n\n确认恢复?`)) return;
            const btn = document.getElementById('cp-modal-revert');
            btn.disabled = true;
            try {
                const r = await cpPost('/api/cp-data/direct/write', {
                    userid: c.userid, appcode: c.appcode, module: c.module, value,
                    redisKey: (s.redis || {}).key || undefined,
                    mysqlName: (s.mysql || {}).name || undefined,
                });
                if (!r.success) throw new Error(r.message);
                document.getElementById('cp-modal-value').value =
                    typeof value === 'string' ? value : JSON.stringify(value, null, 2);
                document.getElementById('cp-modal-result').innerHTML =
                    '<div class="result" style="display:block;">已回灌改前值</div>';
                cpWriteSnapshot = r.data.snapshot;   // 可再次撤回（来回切换）
                btn.disabled = false;
                cpRefreshModule(c.userid, c.appcode, c.module);
            } catch (e) {
                document.getElementById('cp-modal-result').innerHTML =
                    `<div class="result error" style="display:block;">恢复失败: ${cpEscape(e.message)}</div>`;
                btn.disabled = false;
            }
        }

