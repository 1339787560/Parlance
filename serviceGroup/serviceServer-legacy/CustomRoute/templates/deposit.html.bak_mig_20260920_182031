            if (!templateEditMode) return;
            templateEditMode = false;
            templateEditTab = null;
            currentEditingTemplate = null;
            document.querySelectorAll('.template-editing, .template-modified').forEach(el => {
                el.classList.remove('template-editing', 'template-modified');
