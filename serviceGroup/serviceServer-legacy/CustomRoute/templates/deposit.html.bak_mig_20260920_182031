        // ---- CP 数据: 直连 /api/cp-data/direct/* (不经 125 exec_script, 不依赖五元组) ----

        // 缩写下拉: 从 CP 落盘表名动态派生 (xzmp/xzmk/xzmx ...), 不写死
        async function cpInitAppcodes() {
