            .then(response => response.json())
            .then(data => {
                // 移除成功回显，因为用户认为请求一定会成功
                // 如果需要，可以在这里添加其他成功后的逻辑，例如清空表单
            })
            .catch(error => {
                console.error('Fetch Error:', error);
                // 简化错误处理，不显示给用户，因为用户认为请求一定会成功
                // showResult('error', '设置失败：' + error.message, resultDiv);
            });
        }

        // 荣耀特权累计经验阈值表（达到该等级所需累计经验下限）
        // 与 chunkSvr TQVipConfig.lua 单级阈值求和一致；与 leveldefine levelContent 一致
        const TQVIP_THRESHOLDS = [0, 100, 600, 1600, 4600, 9600, 19600, 39600, 79600, 159600, 309600, 609600, 1209600, 2209600, 4209600, 7209600];

        function calcTQVIPGrade(experience) {
            let grade = 0;
            for (let i = 0; i < TQVIP_THRESHOLDS.length; i++) {
                if (experience >= TQVIP_THRESHOLDS[i]) {
                    grade = i;
                } else {
                    break;
                }
            }
            return grade;
        }

        function updateTQVIPGrade() {
            const experience = parseInt(document.getElementById('tqvip-experience').value);
            const gradeDisplay = document.getElementById('tqvip-grade-display');
            const inGradeDisplay = document.getElementById('tqvip-in-grade-display');
