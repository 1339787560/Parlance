    <script>
        // 夜间模式功能实现
        const isDarkMode = localStorage.getItem('darkMode') === 'true';
        if (isDarkMode) {
            document.body.classList.add('dark-theme');
        }
        
        // tab -> 所属分组 (切 tab / 模板 apply 时自动切组)
        const TAB_GROUP = {
            points: 'creator', silver: 'creator', cpdata: 'creator', cpconfig: 'creator', cprequest: 'creator',
            gold: 'lua', tqvip: 'lua', weekcard: 'lua', monthcard: 'lua',
            costume: 'lua', newplayergift: 'lua'
        };

        // 切换顶层分组 (creator / lua); 已在目标组早退 (切 tab 不重复刷组)
        function switchGroup(groupId) {
            const groupEl = document.getElementById('group-' + groupId);
            if (groupEl.classList.contains('active')) return;
            document.querySelectorAll('.group-button').forEach(btn => btn.classList.toggle('active',
                btn.getAttribute('onclick') === `switchGroup('${groupId}')`));
            document.querySelectorAll('.tab-group').forEach(g => g.classList.toggle('active', g === groupEl));
        }

        // 切换组内选项卡 (作用域限定在 tab 所属 group, 避免两组互串)
        // skipClear=true 时不清结果 (初始 DOMContentLoaded 还原缓存用)
        function switchTab(tabId, skipClear) {
            exitTemplateEditMode(); // 切 tab 退出模板编辑
            if (!skipClear) cpClearResults(); // 切 tab 清空已查询内容
            const groupId = TAB_GROUP[tabId];
            if (groupId) switchGroup(groupId); // 模板 apply 跨组时自动带过去 (同组早退)
            const group = document.getElementById('group-' + (groupId || 'lua'));
            const target = document.getElementById(tabId);
            group.querySelectorAll('.tab-button').forEach(btn => btn.classList.toggle('active',
                btn.getAttribute('onclick') === `switchTab('${tabId}')`));
            group.querySelectorAll('.tab-content').forEach(content => content.classList.toggle('active', content === target));
            localStorage.setItem('depositActiveTab', tabId); // 缓存 tab 选择
            // 进 CP 数据 tab: 先拉缩写清单 (从落盘表名派生), 再按 玩家ID + 缩写 自动查询
            if (tabId === 'cpdata' && !skipClear) {
                cpInitAppcodes();
                const uid = document.getElementById('cp-userid').value;
                if (uid && parseInt(uid) > 0) cpLoadModules();
            }
        }

        // 清空 CP 各面板查询结果 (输入保留; 同步清缓存防刷新回显旧结果)
        function cpClearResults() {
            for (const id of ['cp-module-result', 'cp-config-result', 'cp-req-result']) {
                const el = document.getElementById(id);
                if (el) el.innerHTML = '';
            }
            try {
                const state = JSON.parse(localStorage.getItem(CP_CACHE_KEY) || 'null');
                if (state) {
                    delete state.moduleResultHtml;
                    delete state.configResultHtml;
                    delete state.reqResultHtml;
                    localStorage.setItem(CP_CACHE_KEY, JSON.stringify(state));
                }
            } catch (e) { /* 忽略 */ }
        }
        
        // 显示结果消息 (如果需要，可以重新启用)
        function showResult(type, message, resultDiv) {
            resultDiv.className = 'result ' + type;
            resultDiv.textContent = message;
            resultDiv.style.display = 'block';
        }

        // 提交金币设置
        function submitGoldSetting() {
            const operation = document.querySelector('input[name="operationGold"]:checked').value;
            const goldCount = parseInt(document.getElementById('gold-count').value);
            const resultDiv = document.getElementById('resultGold');
            
            // 验证金币数量
            if (isNaN(goldCount) || goldCount <= 0) {
                showResult('error', '请输入有效的金币数量', resultDiv);
                return;
            }
            
            let data = { goldCount: goldCount };
            
            if (operation === 'single') {
                const userId = document.getElementById('user-id-gold').value.trim();
                if (!userId) {
                    showResult('error', '请输入玩家ID', resultDiv);
                    return;
                }
                data.userId = parseInt(userId);
                data.operation = 'single';
            } else {
                const userIdsText = document.getElementById('user-ids-gold').value.trim();
                if (!userIdsText) {
                    showResult('error', '请输入玩家ID列表', resultDiv);
                    return;
                }
                
                const userIds = userIdsText.split(',')
                    .map(id => parseInt(id.trim()))
                    .filter(id => !isNaN(id) && id > 0);
                
                if (userIds.length === 0) {
                    showResult('error', '请输入有效的玩家ID列表', resultDiv);
                    return;
                }
                
                data.userIds = userIds;
                data.operation = 'multi';
            }
            
            // 显示加载状态
            resultDiv.style.display = 'none';
            
            // 发送请求
            fetch('/api/set-gold', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(data => {
                // 移除成功回显，因为用户认为请求一定会成功
                // 如果需要，可以在这里添加其他成功后的逻辑，例如清空表单
            })
            .catch(error => {
                console.error('Fetch Error:', error);
                // 简化错误处理，不显示给用户，因为用户认为请求一定会成功
                // showResult('error', '设置失败：' + error.message, resultDiv);
            });
        }

        // 提交积分设置
        function submitPointsSetting() {
            const userIdsText = document.getElementById('user-id-points').value.trim();
            const count = parseInt(document.getElementById('points-count').value);
            const gameId = parseInt(document.getElementById('game-id-points').value);
            const opid = parseInt(document.querySelector('input[name="opidPoints"]:checked').value);
            const resultDiv = document.getElementById('resultPoints');

            if (!userIdsText) {
                showResult('error', '请输入玩家ID列表', resultDiv);
                return;
            }
            const userIds = userIdsText.split(',').map(id => id.trim()).filter(id => id);
            if (userIds.length === 0) {
                showResult('error', '请输入有效的玩家ID列表', resultDiv);
                return;
            }

            if (isNaN(count)) {
                showResult('error', '请输入有效的积分数量', resultDiv);
                return;
            }
            if (isNaN(gameId)) {
                showResult('error', '请输入有效的游戏ID', resultDiv);
                return;
            }

            resultDiv.style.display = 'none';

            fetch('http://192.168.105.62:5003/setscore', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    userid: userIdsText,
                    count: count,
                    gameid: gameId,
                    opid: opid
                })
            })
            .then(response => response.json())
            .then(data => {
                // 移除成功回显，因为用户认为请求一定会成功
                // 如果需要，可以在这里添加其他成功后的逻辑，例如清空表单
            })
            .catch(error => {
                console.error('Fetch Error:', error);
                // 简化错误处理，不显示给用户，因为用户认为请求一定会成功
                // showResult('error', '设置失败：' + error.message, resultDiv);
