                // 触发change事件以更新显示
                document.querySelector(`input[name="operationGold"][value="${template.data.operation}"]`).dispatchEvent(new Event('change'));

                if (template.data.operation === 'single') {
                    document.getElementById('user-id-gold').value = template.data.userId;
                } else {
                    document.getElementById('user-ids-gold').value = template.data.userIds;
                }
            } else if (template.type === 'points') {
                document.getElementById('user-id-points').value = template.data.userIds;
                document.getElementById('points-count').value = template.data.count;
                document.getElementById('game-id-points').value = template.data.gameId;
                document.querySelector(`input[name="opidPoints"][value="${template.data.opid}"]`).checked = true;
            } else if (template.type === 'silver') {
                document.getElementById('user-id-silver').value = template.data.userIds;
                document.getElementById('silver-count').value = template.data.count;
                document.getElementById('game-id-silver').value = template.data.gameId;
                document.querySelector(`input[name="opidSilver"][value="${template.data.opid}"]`).checked = true;
            } else if (template.type === 'tqvip') {
                document.getElementById('user-ids-tqvip').value = template.data.userIds;
                document.getElementById('tqvip-experience').value = template.data.experience;
                document.getElementById('tqvip-last-login').value = template.data.lastLoginDate || '';
                document.querySelector(`input[name="tqvip-isdemoteani"][value="${template.data.isdemoteani}"]`).checked = true;
                updateTQVIPGrade();
                // rewardstatus 复选框
                const rsBoxes = document.querySelectorAll('#tqvip-rewardstatus input[type="checkbox"]');
                rsBoxes.forEach(cb => cb.checked = false);
                if (template.data.rewardstatus && Array.isArray(template.data.rewardstatus)) {
                    template.data.rewardstatus.forEach(g => {
                        const cb = document.getElementById('tqvip-rs-' + g);
                        if (cb) cb.checked = true;
                    });
                }
            } else if (template.type === 'weekcard') {
                document.getElementById('user-ids-weekcard').value = template.data.userIds;
                document.getElementById('weekcard-days').value = template.data.days;
            } else if (template.type === 'monthcard') {
                document.getElementById('user-ids-monthcard').value = template.data.userIds;
                document.getElementById('monthcard-days').value = template.data.days;
            } else if (template.type === 'costume') {
                document.getElementById('user-id-costume').value = template.data.userId || '';
            } else if (template.type === 'newplayergift') {
                document.getElementById('user-ids-newplayergift').value = template.data.userIds || '';
                document.getElementById('newplayergift-days').value = template.data.days || 0;
                document.getElementById('newplayergift-cancel').checked = template.data.cancel || false;
                const mode = template.data.mode || 'received';
                const modeEl = document.getElementById(mode === 'receivable' ? 'newplayergift-mode-receivable' : 'newplayergift-mode-received');
                if (modeEl) {
                    modeEl.checked = true;
                    updateNewPlayerGiftModeLabel();
                }
            }
            // alert(`模板 "${template.name}" 已应用！`); // 静默启用，移除提示
            currentEditingTemplate = { id: template.id, name: template.name };
            enterTemplateEditMode(template.type);
        }

        // 加载模板列表
        async function loadTemplates() {
            const templateListDiv = document.getElementById('template-list');
            templateListDiv.innerHTML = ''; // 清空现有列表

            try {
                const response = await fetch('/api/templates/get');
                const result = await response.json();

                if (result.success) {
                    result.templates.forEach(template => {
                        const templateItem = document.createElement('div');
                        templateItem.className = 'template-item';
                        templateItem.innerHTML = `
                            <span class="template-name" data-template='${JSON.stringify(template)}'>${template.name} (${template.type})</span>
                            <button class="delete-template-btn" data-id="${template.id}">删除</button>
                        `;
                        templateListDiv.appendChild(templateItem);
                    });
                } else {
                    console.error('获取模板失败:', result.message);
                }
            } catch (error) {
                console.error('加载模板时发生错误:', error);
            }
        }

        // 页面加载完成后执行
        document.addEventListener('DOMContentLoaded', () => {
            const CP_TABS_HIDDEN = true; // CP tab 隐藏期: 缓存兜底跳 points (恢复 CP 时改 false)
            const savedTab = localStorage.getItem('depositActiveTab');
            const cpTabs = ['cpdata', 'cpconfig', 'cprequest'];
            const safeTab = savedTab && TAB_GROUP[savedTab] && !(CP_TABS_HIDDEN && cpTabs.includes(savedTab))
                ? savedTab : 'points';
            switchTab(safeTab, true); // 还原上次 tab (skipClear 保留缓存结果回显)
            cpFillConfigOptions(); // 模块配置下拉
            cpFillReqOptions();    // 模拟请求下拉
            cpRestoreState();    // CP 面板状态还原 (输入 + 上次查询结果)
            loadTemplates(); // 加载模板列表
            updateTQVIPGrade(); // 初始化荣耀特权等级显示

            // 迎新礼包模式切换：同步天数输入框范围与标签
            const modeRadios = document.querySelectorAll('input[name="newplayergift-mode"]');
            modeRadios.forEach(r => r.addEventListener('change', updateNewPlayerGiftModeLabel));
            updateNewPlayerGiftModeLabel();

            // 默认上次登录时间为当前时间
            const lastLoginInput = document.getElementById('tqvip-last-login');
            if (lastLoginInput) {
                const now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                lastLoginInput.value = now.toISOString().slice(0, 19);
            }

            // 绑定模板删除和应用事件
            document.getElementById('template-list').addEventListener('click', async (event) => {
                if (event.target.classList.contains('delete-template-btn')) {
                    const templateId = event.target.dataset.id;
                    if (confirm('确定要删除这个模板吗？')) {
                        try {
                            const response = await fetch('/api/templates/delete', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ id: templateId })
                            });
                            const result = await response.json();
                            if (result.success) {
                                alert('模板删除成功！');
                                loadTemplates(); // 刷新模板列表
                            } else {
                                alert('模板删除失败: ' + result.message);
                            }
                        } catch (error) {
                            console.error('删除模板时发生错误:', error);
                            alert('删除模板时发生网络错误。');
                        }
                    }
                } else if (event.target.classList.contains('template-name')) {
                    const template = JSON.parse(event.target.dataset.template);
                    applyTemplate(template);
                }
            });

            // 初始化金币操作类型显示
            document.querySelectorAll('input[name="operationGold"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    if (this.value === 'single') {
                        document.getElementById('single-form-gold').style.display = 'block';
                        document.getElementById('multi-form-gold').style.display = 'none';
                    } else {
                        document.getElementById('single-form-gold').style.display = 'none';
                        document.getElementById('multi-form-gold').style.display = 'block';
                    }
                });
            });
            // 确保页面加载时根据默认选中的radio显示正确的表单
            if (document.getElementById('singleGold').checked) {
                document.getElementById('single-form-gold').style.display = 'block';
                document.getElementById('multi-form-gold').style.display = 'none';
            } else {
                document.getElementById('single-form-gold').style.display = 'none';
                document.getElementById('multi-form-gold').style.display = 'block';
            }
        });
    </script>
</body>
</html>