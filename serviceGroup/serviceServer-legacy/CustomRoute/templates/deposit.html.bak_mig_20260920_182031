        // 提交迎新礼包设置
        function submitNewPlayerGiftSetting() {
            const userIdsText = document.getElementById('user-ids-newplayergift').value.trim();
            const daysInput = document.getElementById('newplayergift-days');
            const cancelCheckbox = document.getElementById('newplayergift-cancel');
            const resultDiv = document.getElementById('resultNewPlayerGift');
            const modeRadio = document.querySelector('input[name="newplayergift-mode"]:checked');
            const mode = modeRadio ? modeRadio.value : 'received';

            if (!userIdsText) {
                showResult('error', '请输入玩家ID列表', resultDiv);
                return;
            }
            const userIds = userIdsText.split(',').map(id => parseInt(id.trim())).filter(id => !isNaN(id) && id > 0);
            if (userIds.length === 0) {
                showResult('error', '请输入有效的玩家ID列表', resultDiv);
                return;
            }

            const cancel = cancelCheckbox.checked;
            let payload = { userIds: userIds, cancel: cancel };

            if (!cancel) {
                const days = parseInt(daysInput.value);
                if (mode === 'receivable') {
                    if (isNaN(days) || days < 1 || days > 7) {
                        showResult('error', '可领天数必须是 1-7 的整数', resultDiv);
                        return;
                    }
                    payload.receivableDay = days;
                } else {
                    if (isNaN(days) || days < 0 || days > 7) {
                        showResult('error', '已领取天数必须是 0-7 的整数', resultDiv);
                        return;
                    }
                    payload.receivedays = days;
                }
            }

            resultDiv.style.display = 'none';

            fetch('/api/set-newplayer-gift', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    let msg = data.message + '\n';
                    for (const [uid, res] of Object.entries(data.results)) {
                        msg += `${uid}: ${res}\n`;
                    }
                    showResult('success', msg, resultDiv);
                } else {
                    showResult('error', data.message || '设置失败', resultDiv);
                }
            })
            .catch(error => {
                showResult('error', '网络错误：' + error.message, resultDiv);
            });
        }

