# infoServer — 本机辅助/孵化配置 (走法 A: host 无 HTTP).
#
# 本机定位 (2026-09-02 三配置拆分):
#   - 6 个已融入 castflow 的服务 (parlance-chat / serviceServer-rust / statistic-server /
#     debug-relay / session-registry / webreader) 在此 disabled → 由 castflow ExtensionManager
#     托管 (skillrepo: modules.yaml + extensions/<id>/extension.yaml, 含保活/崩溃重启)。
#   - 本文件保留: infoserver 独有服务 + 孵化中(lab)服务; 堡垒机全量部署用 config.full.yaml。
#   - 新服务孵化进本文件; 升入 castflow 时: 写 extension.yaml → 本条 disabled → 确认 full 版同步。
#
# host (main.py) 是纯进程启动器, 不监听任何 TCP 端口。
# server.port 仅供 run.py 启动器预清理端口用(为 parlanceChat 让出 5001);
# host 自身不绑定它。所有可插拔子服务在下方 services 列表声明, enabled 即装/卸。

server:
  host: 0.0.0.0
  port: 5001    # run.py 预清理此端口; 实际由 parlance-chat 子服务占用

# 共享主题开关 (parlance :5001 /api/theme/config 暴露给子服务前端)
# enabled=false → 全局关共享, 所有子服务前端走纯本地主题 (localStorage)
# exclude → 列表内服务名前端走纯本地 (不 fetch /api/theme, 不引 5001 背景图)
# 已知服务名: statistic / debugRelay / np-reader (前端硬编码 SERVICE_NAME)
shared_theme:
  enabled: true
  exclude: [np-reader]

# Managed services - launched as subprocesses by ServiceGroupManager
# Fields: name, command, args, cwd, env, auto_restart, health_check, tags, enabled, managed, port
#   managed=true (default): killed on parent exit via Job Object
#   managed=false: fire-and-forget, survives parent exit
#   port=<number>: auto-free port before start (kill occupying process)
services:
  - name: parlance-chat        # 融入 castflow: extensions/parlance-chat/extension.yaml
    command: python
    command_mac: ./.venv/bin/python
    args: ["main.py", "--port", "5001"]
    cwd: ./serviceGroup/parlanceChat
    port: 5001
    auto_restart: true
    tags: [chat, parlance]
    enabled: false

  # Caddy reverse proxy for parlance HTTPS/HTTP2 + HTTP fallback.
  # Managed by InfoServer: auto-restart, port cleanup, same lifecycle as other services.
  - name: caddy-parlance
    command: C:/Users/admin/AppData/Local/Microsoft/WinGet/Links/caddy.exe
    args: ["run", "--config", "C:/Users/admin/parlance-certs/Caddyfile", "--adapter", "caddyfile"]
    cwd: C:/Users/admin/parlance-certs
    port: 8443
    auto_restart: true
    tags: [parlance, https, proxy]
    enabled: true

  - name: serviceServer-rust    # 融入 castflow: extensions/service-server/extension.yaml
    command: ./serviceGroup/serviceServer/service-server.exe
    command_mac: ./serviceGroup/serviceServer/target/release/service-server
    cwd: ./serviceGroup/serviceServer
    port: 5000
    auto_restart: true
    tags: [service, api]
    # 2026-09-21 本机改 enabled: true —— 与 config.full.yaml(堡垒机) 对齐, 让宿主真正持有
    # :5000 的句柄, 从而支持「整包发布换代 (swap_exe) + 重启自身 + 开机自起」。
    # 前置: 本机 castflow 未运行, 让位未生效; 若将来本机切 castflow ExtensionManager 托管,
    # 必须回退 false, 否则双宿主争抢 5000。
    enabled: true
    env:
      # SERVICESVR_CONFIG 基准 = Rust 子进程 cwd (serviceGroup/serviceServer), 故用 ../ 到 legacy
      SERVICESVR_CONFIG: ../serviceServer-legacy/config.json
      # strangler 反代目标 = legacy Flask。2026-09-22 起 :5099 让位给 L2 发布面 → legacy 退居 5098
      SERVICESVR_LEGACY_URL: http://127.0.0.1:5098
      # 发布面 (:5099, 由 L2 run.py 承接) —— 工具自身重启委派给它: 它不在被重启目标内,
      # 停机窗口仍能应答 (旧值指 legacy_backend, 切流后会打到 5098 那里已无 /api/deploy/*)
      SERVICESVR_DEPLOY_URL: http://127.0.0.1:5099
      RUST_LOG: info
      SERVICESVR_HOST_ID: local
      SERVICESVR_BASTION_53_URL: http://192.168.102.53:5000
      SERVICESVR_BASTION_185_URL: http://192.168.52.185:5000
      # 货币/礼包端点经 luaDataTool.py 读写游戏库 (mysql/redis/protobuf) —— 必须用带这些
      # 依赖的解释器。**本机实测**: 进程 PATH 里的 `python` 会解析到 C:\Python314 (缺 mysql),
      # 而 legacy 服务实际跑在 D:\Compiler\python (依赖齐), 故此处显式钉定, 不赌 PATH。
      # 换机器/堡垒机按其本机实际解释器改 (config.full.yaml 侧同理, 缺省仍走 python)。
      SERVICESVR_PYTHON: D:/Compiler/python/python.exe

  - name: serviceServer-legacy
    command: python
    command_mac: ./serviceGroup/serviceServer-legacy/.venv/bin/python
    args: ["main.py"]
    cwd: ./serviceGroup/serviceServer-legacy
    # 2026-09-22 起让位 :5099 (发布面搬到 L2 run.py), 退居 5098 —— 只服务 CP 路由
    # (/api/cp-data/* + /api/migration/dryrun; 发布通道已从 legacy 摘除)
    port: 5098
    auto_restart: true
    tags: [service, api, legacy]
    enabled: true
    env:
      SERVICESVR_PORT: "5098"

  - name: statistic-server      # 融入 castflow: extensions/statistic-server/extension.yaml
    command_mac: ./serviceGroup/statisticServer/target/release/statistic-server
    command_win: .\serviceGroup\statisticServer\target\release\statistic-server.exe
    args: []
    cwd: ./serviceGroup/statisticServer
    port: 5002
    auto_restart: true
    tags: [statistics, proxy]
    enabled: false
    env:
      ANTHROPIC_TARGET: "http://aiapi.tcy365.net:82"
      OPENAI_TARGET: "http://aiapi.tcy365.net:82/v1"

  - name: debug-relay           # 融入 castflow: extensions/debug-relay/extension.yaml
    command_mac: ./.venv/bin/python
    command_win: python
    args: ["debug_relay.py", "--port", "5003", "--src", "D:\\Codlib\\douque\\xzmx\\ClientEngineGame\\trunk\\assets"]
    args_mac: ["debug_relay.py", "--port", "5003"]   # Mac 无客户端 assets, 不带 --src
    cwd: ./serviceGroup/debugRelay
    port: 5003
    auto_restart: true
    tags: [debug, game, cocos]
    enabled: false

  - name: session-registry      # 融入 castflow: extensions/session-registry/extension.yaml
    command_mac: ./.venv/bin/python
    command_win: python
    args: ["main.py", "--port", "5011"]
    cwd: ./serviceGroup/sessionRegistry
    port: 5011
    auto_restart: true
    tags: [session, registry, agent]
    enabled: false


  - name: np-reader
    # Novel-Pineline 与 infoServer 同级 (../Novel-Pineline), 相对化后任意主机同根即可部署
    command: ../Novel-Pineline/.venv/Scripts/np.exe
    command_mac: /Users/liz/codlib/python/Novel-Pineline/.venv/bin/np
    args: ["reader", "serve", "--host", "0.0.0.0", "--port", "8000", "--library", "../Novel-Pineline/library"]
    args_mac: ["reader", "serve", "--host", "0.0.0.0", "--port", "8000", "--library", "/Users/liz/codlib/python/Novel-Pineline/library"]
    cwd: ../Novel-Pineline
    cwd_mac: /Users/liz/codlib/python/Novel-Pineline
    port: 8000
    auto_restart: true
    tags: [reader, novel, web]
    enabled: true

  # WebReader — 融入 castflow: extensions/webreader/extension.yaml (本机由 castflow 托管)
  - name: webreader
    command_win: .\serviceGroup\webreader\webreader-server.exe
    command_mac: ./serviceGroup/webreader/webreader-server
    args: ["config.json"]
    args_mac: ["config.mac.json"]     # Mac 本机配置 (gitignored, workspace 指向 Mac skillrepo)
    cwd: ./serviceGroup/webreader
    port: 5090
    auto_restart: true
    tags: [reader, web, doc, rolemanager]
