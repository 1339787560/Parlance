{
	// 模块：对局抽奖
	// 功能：玩家在普通房间（经典/不洗牌/癞子）完成对局，累计局数完成任务阶段后获得抽奖券，
	//       使用抽奖券参与抽奖获取奖励。5个场次档位（R1~R5）各自独立配置任务阶段与奖池。
	//       阶段按顺序解锁，末段循环。每日0点重置对局进度与阶段，每周一0点重置抽奖券。

	// 开关
	"isenable": 1,
	"continueCount":1,

	// 发奖兑换ID
	"guid": "JC188028300000200991776767612587",

	// 抽奖券道具ID
	"ticketPropId": 99999,

	// 抽奖券库存上限
	"ticketLimit": 999,

	// 获奖记录最大保留条数
	"recordMaxCount": 50,

	// 每日重置时间（服务器时间，小时:分钟）
	"dailyResetTime": "00:00",

	// 每周重置日（1=周一）
	"weeklyResetDay": 1,

	// 新手任务配置：新用户首次任务所需局数，完成一次后失效，不重置最多保留3个月
	"newbieTask": {
		"enabled": 1,
		"targetWins": 1,
		"ticketPerComplete": 1,
		"rewardPoolId": "NEWBIE_POOL",
		"maxRetainDays": 90
	},

